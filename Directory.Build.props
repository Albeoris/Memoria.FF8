<Project>
  <!-- The product is a plain .NET solution: it inherits nothing from the workspace or an enclosing repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EngineCompatibilityVersion>0.9.14</EngineCompatibilityVersion>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <!-- A solution cannot take RuntimeIdentifier globally; project evaluation resolves the graph's requested RID. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(MemoriaBuildRuntimeIdentifier)' != ''">$(MemoriaBuildRuntimeIdentifier)</RuntimeIdentifier>
    <MemoriaTargetRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MemoriaTargetRuntime>
    <MemoriaTargetRuntime Condition="'$(MemoriaTargetRuntime)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MemoriaTargetRuntime>
    <MemoriaTargetRuntime Condition="'$(MemoriaTargetRuntime)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</MemoriaTargetRuntime>
    <MemoriaTargetRuntime Condition="'$(MemoriaTargetRuntime)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">osx-arm64</MemoriaTargetRuntime>
    <MemoriaTargetRuntime Condition="'$(MemoriaTargetRuntime)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</MemoriaTargetRuntime>
    <MemoriaTargetMac Condition="'$(MemoriaTargetRuntime)' == 'osx-x64' Or '$(MemoriaTargetRuntime)' == 'osx-arm64'">true</MemoriaTargetMac>
    <MemoriaTargetArchitecture Condition="'$(MemoriaTargetRuntime)' == 'osx-arm64'">arm64</MemoriaTargetArchitecture>
    <MemoriaTargetArchitecture Condition="'$(MemoriaTargetArchitecture)' == ''">x64</MemoriaTargetArchitecture>
    <MemoriaGraphicsBackend Condition="'$(MemoriaGraphicsBackend)' == '' And ('$(MemoriaTargetRuntime)' == 'linux-x64' Or '$(MemoriaTargetMac)' == 'true')">Vulkan</MemoriaGraphicsBackend>
    <MemoriaGraphicsBackend Condition="'$(MemoriaGraphicsBackend)' == ''">Direct3D11</MemoriaGraphicsBackend>
    <MemoriaNativeGraphics Condition="'$(MemoriaGraphicsBackend)' == 'Vulkan' Or '$(MemoriaGraphicsBackend)' == 'Direct3D12'">true</MemoriaNativeGraphics>
    <DefineConstants Condition="'$(MemoriaNativeGraphics)' == 'true'">$(DefineConstants);MEMORIA_NATIVE</DefineConstants>
    <DefineConstants Condition="'$(MemoriaGraphicsBackend)' == 'Direct3D12'">$(DefineConstants);MEMORIA_DX12</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == '' And '$(ArtifactsPath)' == ''">obj/$(MemoriaGraphicsBackend)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == '' And '$(ArtifactsPath)' == ''">bin/$(MemoriaGraphicsBackend)/</BaseOutputPath>
    <DefineConstants Condition="'$(MemoriaGraphicsBackend)' == 'Vulkan'">$(DefineConstants);MEMORIA_VULKAN</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Memoria.FF8.Platform'">
    <AssemblyMetadata Include="EngineCompatibilityVersion" Value="$(EngineCompatibilityVersion)" />
  </ItemGroup>
  <ItemGroup>
    <BundledMemoriaComponent Include="Depixelation;EdeaMirrors;Extended FFVIII Roster;FF7EnemyIntegration;Level-Based Stat Bonuses;Meltdown;Reorientation;Rinoa Hair Physics" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Memoria.Launcher' Or '$(MSBuildProjectName)' == 'Memoria.FF8.App' Or '$(MSBuildProjectName)' == 'Memoria.FF8.Bootstrap' Or '$(MSBuildProjectName)' == 'Memoria.FF8.Music'">
    <ApplicationIcon>$(MSBuildThisFileDirectory)Artwork/Application/application.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
