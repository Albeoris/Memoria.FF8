<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <AssemblyName>Memoria.FF8.Music</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Memoria.FF8.App/WindowsAudioCom.cs" Link="WindowsAudioCom.cs" />
  </ItemGroup>
  <Target Name="GetMusicHostFiles" Returns="@(MusicHostFile)">
    <ItemGroup>
      <MusicHostFile Include="$(TargetDir)**/*" />
    </ItemGroup>
  </Target>
</Project>
