<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <PlatformTarget>$(MemoriaTargetArchitecture)</PlatformTarget>
    <AssemblyName>Memoria.Launcher</AssemblyName>
    <RootNamespace>Memoria.Launcher</RootNamespace>
    <PublishSingleFile Condition="'$(MemoriaTargetRuntime)' == 'win-x64'">true</PublishSingleFile>
    <PublishSingleFile Condition="'$(MemoriaTargetRuntime)' != 'win-x64'">false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <Using Include="System.IO" />
    <Compile Include="../Memoria.FF8.App/MediaToolsInstallation.cs" Link="MediaToolsInstallation.cs" />
    <ProjectReference Include="../../vendor/Albeoris.Frameworks/Albeoris.Games.SteamLibrary/Albeoris.Games.SteamLibrary/Albeoris.Games.SteamLibrary.csproj" />
    <ProjectReference Include="../Memoria.FF8.Platform/Memoria.FF8.Platform.csproj" />
    <ProjectReference Include="../Memoria.FF8.Resources/Memoria.FF8.Resources.csproj" />
    <ProjectReference Include="../Memoria.FF8.Mods/Memoria.FF8.Mods.csproj" />
    <InternalsVisibleTo Include="Memoria.Launcher.Tests" />
  </ItemGroup>
  <Import Project="../../tools/packaging/MacBundleLauncher.targets" />
  <!-- Released Linux updaters reject extensionless root companions. The optional
       .NET crash-dump helper is not part of the launcher's runtime closure. -->
  <Target Name="ExcludeLinuxLauncherDumpHelper" AfterTargets="ComputeFilesToPublish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'createdump'" />
    </ItemGroup>
  </Target>
</Project>
