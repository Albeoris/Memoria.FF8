<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Memoria.FF8</AssemblyName>
    <RootNamespace>Memoria.FF8</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Memoria.FF8.Mods/Memoria.FF8.Mods.csproj" />
    <Using Include="System.IO" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" />
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Windows" />
    <ProjectReference Include="../Memoria.FF8.Runtime/Memoria.FF8.Runtime.csproj" />
    <ProjectReference Include="../../vendor/Albeoris.Frameworks/Albeoris.Games.FF8.KernelBin/Albeoris.Games.FF8.KernelBin.csproj" />
    <ProjectReference Include="../../vendor/Albeoris.Frameworks/Albeoris.Games.FF8.NamedicBin/Albeoris.Games.FF8.NamedicBin.csproj" />
    <ProjectReference Include="../../vendor/Albeoris.Frameworks/Albeoris.Games.FF8.MngrpBin/Albeoris.Games.FF8.MngrpBin.csproj" />
    <ProjectReference Include="../Memoria.FF8.Ui/Memoria.FF8.Ui.csproj" />
    <ProjectReference Include="../Memoria.FF8.Media/Memoria.FF8.Media.csproj" />
    <ProjectReference Include="../Memoria.FF8.Assets/Memoria.FF8.Assets.csproj" />
    <ProjectReference Include="../Memoria.FF8.Rendering/Memoria.FF8.Rendering.csproj" />
    <ProjectReference Include="../Memoria.FF8.TitleScene/Memoria.FF8.TitleScene.csproj" />
    <ProjectReference Include="../Memoria.FF8.Events/Memoria.FF8.Events.csproj" />
    <ProjectReference Include="../Memoria.FF8.Music/Memoria.FF8.Music.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" AdditionalProperties="RuntimeIdentifier=win-x86;SelfContained=true" />
  </ItemGroup>
  <Target Name="CopyMusicHost" AfterTargets="Build">
    <MSBuild Projects="../Memoria.FF8.Music/Memoria.FF8.Music.csproj" Targets="GetMusicHostFiles" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x86;SelfContained=true">
      <Output TaskParameter="TargetOutputs" ItemName="MusicHostFile" />
    </MSBuild>
    <Copy SourceFiles="@(MusicHostFile)" DestinationFiles="@(MusicHostFile->'$(OutDir)audio-host/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishMusicHost" AfterTargets="Publish">
    <ItemGroup>
      <MusicHostPublishFile Include="$(OutDir)audio-host/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(MusicHostPublishFile)" DestinationFiles="@(MusicHostPublishFile->'$(PublishDir)audio-host/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
