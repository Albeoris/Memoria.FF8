<Project>
  <Import Project="../Directory.Build.targets" />
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <DefineConstants>$(DefineConstants);FF8_XUNIT_RESOURCE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TestResources.cs" Link="TestResources.cs" />
    <Using Include="Memoria.FF8.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Keep real skipped results and summary counts, without a block for every optional fixture. -->
    <None Include="$(MSBuildThisFileDirectory)Shared/testconfig.json" Link="$(AssemblyName).testconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Shared/optional-fixture-inputs.json" LogicalName="Memoria.OptionalFixtureInputs.json" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/OptionalFixtureNotice.cs" Link="OptionalFixtureNotice.cs" />
  </ItemGroup>
</Project>
