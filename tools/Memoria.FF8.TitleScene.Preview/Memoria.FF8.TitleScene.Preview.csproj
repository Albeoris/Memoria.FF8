<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Memoria.FF8.TitleScene/Memoria.FF8.TitleScene.csproj" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Condition="'$(MemoriaGraphicsBackend)' == 'Vulkan' And '$(MemoriaTargetRuntime)' == 'win-x64'" />
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Condition="'$(MemoriaGraphicsBackend)' == 'Direct3D12'" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Condition="'$(MemoriaGraphicsBackend)' == 'Vulkan' And '$(MemoriaTargetRuntime)' == 'linux-x64'" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Condition="'$(MemoriaGraphicsBackend)' == 'Vulkan' And '$(MemoriaTargetRuntime)' == 'osx-x64'" />
  </ItemGroup>
  <Import Project="../../vendor/MonoGame.Native.DX12/NativeDirect3D12.targets" />
</Project>
