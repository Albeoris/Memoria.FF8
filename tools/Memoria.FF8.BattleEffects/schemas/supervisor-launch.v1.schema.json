{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoria:ff8:battle-effects:supervisor-launch:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "no_progress_ms": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400000
    },
    "environment": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "executable",
    "arguments",
    "working_directory",
    "no_progress_ms",
    "environment"
  ],
  "additionalProperties": false
}
