{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoria:ff8:battle-effects:inventory:v1",
  "title": "Battle effects inventory record v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "resource_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "action_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "effect_key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
          },
          "native_effect_id": {
            "type": "integer",
            "minimum": 0
          },
          "disposition": {
            "enum": [
              "scheduled",
              "covered_by_case",
              "unresolved",
              "excluded_with_reason"
            ]
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "mapping_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "entry_id",
          "action_id",
          "effect_key",
          "native_effect_id",
          "disposition",
          "case_ids",
          "mapping_evidence",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "resource_hash",
    "entries"
  ],
  "additionalProperties": false
}
