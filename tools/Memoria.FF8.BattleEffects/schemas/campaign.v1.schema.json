{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoria:ff8:battle-effects:campaign:v1",
  "title": "Battle effects campaign record v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_campaign": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instrumentation_version": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "plan_revision",
    "parent_campaign",
    "plan_hash",
    "build_hash",
    "profile_hash",
    "resource_hash",
    "instrumentation_version",
    "created_utc"
  ],
  "additionalProperties": false
}
