<Project>
  <PropertyGroup Condition="'$(MemoriaGraphicsBackend)' == 'Vulkan'">
    <MemoriaNativeVulkanLibrary Condition="'$(MemoriaTargetRuntime)' == 'win-x64'">mgruntime.dll</MemoriaNativeVulkanLibrary>
    <MemoriaNativeVulkanLibrary Condition="'$(MemoriaTargetRuntime)' == 'linux-x64'">libmgruntime.so</MemoriaNativeVulkanLibrary>
    <MemoriaNativeVulkanLibrary Condition="'$(MemoriaTargetRuntime)' == 'osx-x64' or '$(MemoriaTargetRuntime)' == 'osx-arm64'">libmgruntime.dylib</MemoriaNativeVulkanLibrary>
    <MemoriaNativeVulkanPackageRid>$(MemoriaTargetRuntime)</MemoriaNativeVulkanPackageRid>
    <MemoriaNativeVulkanPackageRid Condition="'$(MemoriaNativeVulkanLibrary)' == 'libmgruntime.dylib'">osx</MemoriaNativeVulkanPackageRid>
    <MemoriaNativeVulkanDirectory Condition="'$(MemoriaNativeVulkanDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native-vulkan/$(MemoriaTargetRuntime)'))</MemoriaNativeVulkanDirectory>
    <MemoriaNativeVulkanDistroArgument Condition="'$(MemoriaNativeVulkanDistro)' != ''">-Distro &quot;$(MemoriaNativeVulkanDistro)&quot;</MemoriaNativeVulkanDistroArgument>
  </PropertyGroup>
  <Target Name="BuildNativeVulkanRuntime" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(MemoriaNativeVulkanLibrary)' != ''">
    <Exec Condition="'$(MemoriaNativeVulkanPrepared)' != 'true'" Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)../../tools/Build-NativeVulkan.ps1&quot; -RuntimeIdentifier &quot;$(MemoriaTargetRuntime)&quot; -OutputDirectory &quot;$(MemoriaNativeVulkanDirectory)&quot; $(MemoriaNativeVulkanDistroArgument)" />
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)../../tools/Build-NativeVulkan.ps1&quot; -RuntimeIdentifier &quot;$(MemoriaTargetRuntime)&quot; -OutputDirectory &quot;$(MemoriaNativeVulkanDirectory)&quot; -VerifyOnly" />
  </Target>
  <Target Name="CopyNativeVulkanRuntime" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="BuildNativeVulkanRuntime" Condition="'$(MemoriaNativeVulkanLibrary)' != ''">
    <ItemGroup>
      <NativeVulkanNotice Include="$(MemoriaNativeVulkanDirectory)/licenses/**/*" />
    </ItemGroup>
    <Copy SourceFiles="$(MemoriaNativeVulkanDirectory)/$(MemoriaNativeVulkanLibrary);$(MemoriaNativeVulkanDirectory)/native-runtime.json" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="$(MemoriaNativeVulkanDirectory)/$(MemoriaNativeVulkanLibrary)" DestinationFolder="$(TargetDir)runtimes/$(MemoriaNativeVulkanPackageRid)/native/" Condition="Exists('$(TargetDir)runtimes/$(MemoriaNativeVulkanPackageRid)/native/$(MemoriaNativeVulkanLibrary)')" />
    <Copy SourceFiles="@(NativeVulkanNotice)" DestinationFiles="@(NativeVulkanNotice->'$(TargetDir)licenses/MonoGame.Native.Vulkan/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishNativeVulkanRuntime" AfterTargets="Publish" DependsOnTargets="BuildNativeVulkanRuntime" Condition="'$(MemoriaNativeVulkanLibrary)' != ''">
    <ItemGroup>
      <NativeVulkanPublishNotice Include="$(MemoriaNativeVulkanDirectory)/licenses/**/*" />
    </ItemGroup>
    <Copy SourceFiles="$(MemoriaNativeVulkanDirectory)/$(MemoriaNativeVulkanLibrary);$(MemoriaNativeVulkanDirectory)/native-runtime.json" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="$(MemoriaNativeVulkanDirectory)/$(MemoriaNativeVulkanLibrary)" DestinationFolder="$(PublishDir)runtimes/$(MemoriaNativeVulkanPackageRid)/native/" Condition="Exists('$(PublishDir)runtimes/$(MemoriaNativeVulkanPackageRid)/native/$(MemoriaNativeVulkanLibrary)')" />
    <Copy SourceFiles="@(NativeVulkanPublishNotice)" DestinationFiles="@(NativeVulkanPublishNotice->'$(PublishDir)licenses/MonoGame.Native.Vulkan/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
