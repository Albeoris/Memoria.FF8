+#if defined(MG_VULKAN) && !defined(_WIN32)
+static const char* const memoriaWindowKey = "Memoria.Window";
+
+static bool IsNormalWindow(Uint32 flags)
+{
+    return (flags & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MAXIMIZED | SDL_WINDOW_MINIMIZED | SDL_WINDOW_BORDERLESS)) == 0;
+}
+
+static int SDLCALL TrackNormalBounds(void* data, SDL_Event* event)
+{
+    auto window = static_cast<MGP_Window*>(data);
+    if (event->type != SDL_WINDOWEVENT || event->window.windowID != window->windowId)
+        return 1;
+
+    if (!IsNormalWindow(SDL_GetWindowFlags(window->window)))
+        return 1;
+
+    if (event->window.event == SDL_WINDOWEVENT_MOVED)
+    {
+        window->normalBounds.x = event->window.data1;
+        window->normalBounds.y = event->window.data2;
+    }
+    else if (event->window.event == SDL_WINDOWEVENT_RESIZED || event->window.event == SDL_WINDOWEVENT_SIZE_CHANGED)
+    {
+        window->normalBounds.w = event->window.data1;
+        window->normalBounds.h = event->window.data2;
+    }
+    return 1;
+}
+
+struct MemoriaWindowGeometry
+{
+    SDL_Rect bounds;
+    SDL_Rect normalBounds;
+    int pixelWidth;
+    int pixelHeight;
+    int maximized;
+    int hidden;
+    int supportsHiddenPresentation;
+};
+
+MG_EXPORT int Memoria_Window_GetGeometry(SDL_Window* handle, MemoriaWindowGeometry* geometry)
+{
+    auto window = static_cast<MGP_Window*>(SDL_GetWindowData(handle, memoriaWindowKey));
+    if (!window)
+        return 0;
+
+    const Uint32 flags = SDL_GetWindowFlags(handle);
+    SDL_GetWindowPosition(handle, &geometry->bounds.x, &geometry->bounds.y);
+    SDL_GetWindowSize(handle, &geometry->bounds.w, &geometry->bounds.h);
+    SDL_GetWindowSizeInPixels(handle, &geometry->pixelWidth, &geometry->pixelHeight);
+    if (IsNormalWindow(flags))
+        window->normalBounds = geometry->bounds;
+
+    geometry->normalBounds = window->normalBounds;
+    geometry->maximized = window->maximizeOnShow || (flags & SDL_WINDOW_MAXIMIZED) != 0;
+    geometry->hidden = (flags & SDL_WINDOW_HIDDEN) != 0;
+    geometry->supportsHiddenPresentation = SDL_strcmp(SDL_GetCurrentVideoDriver(), "wayland") != 0;
+    return 1;
+}
+
+static void ShowMemoriaWindow(MGP_Window* window)
+{
+    SDL_ShowWindow(window->window);
+    if (window->maximizeOnShow)
+    {
+        window->maximizeOnShow = false;
+        if (!(SDL_GetWindowFlags(window->window) & SDL_WINDOW_FULLSCREEN))
+            SDL_MaximizeWindow(window->window);
+    }
+}
+
+MG_EXPORT void Memoria_Window_Maximize(SDL_Window* handle)
+{
+    auto window = static_cast<MGP_Window*>(SDL_GetWindowData(handle, memoriaWindowKey));
+    // Let Wayland complete the initial configure before requesting a maximized size.
+    if (SDL_GetWindowFlags(handle) & SDL_WINDOW_HIDDEN)
+        window->maximizeOnShow = true;
+    else
+        SDL_MaximizeWindow(handle);
+}
+
+MG_EXPORT void Memoria_Window_RestorePlacement(SDL_Window* handle, int x, int y, int width, int height, int maximized)
+{
+    auto window = static_cast<MGP_Window*>(SDL_GetWindowData(handle, memoriaWindowKey));
+    window->maximizeOnShow = false;
+    SDL_RestoreWindow(handle);
+    SDL_SetWindowPosition(handle, x, y);
+    SDL_SetWindowSize(handle, width, height);
+    if (maximized)
+        Memoria_Window_Maximize(handle);
+}
+
+MG_EXPORT void Memoria_Window_SetTransferHidden(SDL_Window* handle, int hidden)
+{
+    auto window = static_cast<MGP_Window*>(SDL_GetWindowData(handle, memoriaWindowKey));
+    window->transferHidden = hidden != 0;
+    if (window->transferHidden)
+    {
+        SDL_HideWindow(handle);
+    }
+    else
+    {
+        ShowMemoriaWindow(window);
+        SDL_RaiseWindow(handle);
+    }
+}
